{
  "$schema": "../../../claudinite-tasks/task.schema.json",
  "id": "prose-to-checks-sweep",
  "description": "Mines this repository's existing pack prose for always-testable rules the conversion missed and converts the strongest ones into checks.",
  "trigger": "schedule",
  "preconditions": [
    "schedule:at-most-weekly",
    "repo-active"
  ],
  "expected_outcome": "amend_existing_or_create_new_pr",
  "automerge": [
    "under:.claudinite/local"
  ],
  "agent_model": "opus",
  "agent_instructions": "task.md",
  "agent_execution_timeout": 2700
}
