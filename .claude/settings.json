{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": ".claudinite/bin/cn hook post-tool-use",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": ".claudinite/bin/cn hook pre-tool-use",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": ".claudinite/bin/cn hook session-end",
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "if sh \"$CLAUDE_PROJECT_DIR/.claudinite/setup-cn.sh\"; then \"$CLAUDE_PROJECT_DIR/.claudinite/bin/cn\" hook session-start; fi",
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": ".claudinite/bin/cn hook stop",
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": ".claudinite/bin/cn hook user-prompt-submit",
            "type": "command"
          }
        ]
      }
    ]
  }
}
